generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  status      String   @default("active")
  email       String?
  phone       String?
  address     String?
  city        String?
  timezone    String   @default("America/Chicago")
  welcomeNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  students   Student[]
  classes    Class[]
  staff      Staff[]
  invoices   Invoice[]
  expenses   Expense[]
  attendance Attendance[]
  homework   Homework[]
  progress   QuranProgress[]
  emails     EmailLog[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         String
  phone        String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  taughtClasses    Class[]           @relation("ClassTeacher")
  children         Student[]         @relation("ParentChildren")
  markedAttendance Attendance[]      @relation("AttendanceMarker")
  assignedHomework Homework[]        @relation("HomeworkAssigner")
  recordedProgress QuranProgress[]   @relation("ProgressRecorder")
  staffProfile     Staff?

  @@unique([tenantId, email])
  @@index([tenantId, role])
}

model Staff {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String?
  phone     String?
  title     String
  startDate String?
  salary    Float?
  notes     String?
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Class {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  level     String?
  dayOfWeek String?
  startTime String?
  endTime   String?
  room      String?
  teacherId String?
  teacher   User?    @relation("ClassTeacher", fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students   Student[]
  attendance Attendance[]
  homework   Homework[]

  @@index([tenantId])
}

model Student {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  dateOfBirth String?
  gender      String?
  parentId    String?
  parent      User?    @relation("ParentChildren", fields: [parentId], references: [id])
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  status      String   @default("pending")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attendance          Attendance[]
  progress            QuranProgress[]
  invoices            Invoice[]
  homeworkCompletions HomeworkCompletion[]

  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Attendance {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  date       String
  status     String
  markedById String?
  markedBy   User?    @relation("AttendanceMarker", fields: [markedById], references: [id])
  createdAt  DateTime @default(now())

  @@unique([tenantId, studentId, classId, date])
  @@index([tenantId])
}

model Homework {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assignedDate String
  dueDate      String?
  assignedById String?
  assignedBy   User?    @relation("HomeworkAssigner", fields: [assignedById], references: [id])
  createdAt    DateTime @default(now())

  completions HomeworkCompletion[]

  @@index([tenantId])
}

model HomeworkCompletion {
  id         String   @id @default(cuid())
  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     String   @default("assigned")
  updatedAt  DateTime @updatedAt

  @@unique([homeworkId, studentId])
}

model QuranProgress {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  surah        String
  ayahFrom     Int
  ayahTo       Int
  juz          Int?
  notes        String?
  date         String
  recordedById String?
  recordedBy   User?    @relation("ProgressRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([tenantId, studentId])
}

model Invoice {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId  String?
  amount    Float
  dueDate   String
  paidDate  String?
  status    String
  period    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

model Expense {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    String
  amount      Float
  date        String
  vendor      String?
  description String?
  staffId     String?
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

model EmailLog {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  toEmail   String
  subject   String
  body      String
  event     String
  status    String   @default("logged")
  createdAt DateTime @default(now())

  @@index([tenantId])
}
