APP_ENV=staging
APP_URL=https://staging.ourdugsi.com

# Staging Supabase: https://wploiyfewcygrucoysdb.supabase.co
# Project Settings → Database → Connection string
# DATABASE_URL = Transaction pooler (port 6543) with ?pgbouncer=true
# DIRECT_URL   = Direct / session mode (port 5432)
DATABASE_URL="postgresql://postgres.wploiyfewcygrucoysdb:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.wploiyfewcygrucoysdb:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

AUTH_SECRET=use-a-different-secret-from-production
MOBILE_ORIGIN=https://staging.ourdugsi.com
RESEND_API_KEY=
EMAIL_FROM=Dugsi Staging <noreply@ourdugsi.com>
